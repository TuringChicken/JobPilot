# Copy to .env and fill in real values. Never commit .env.

# Shared secret the Chrome extension sends in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

DATABASE_URL=sqlite:///./data/jobpilot.db

# LLM provider: "dashscope" (Alibaba Cloud Model Studio) or "azure"
LLM_PROVIDER=dashscope
LLM_TIMEOUT_SECONDS=120

# DashScope (OpenAI-compatible mode). Keys are region-specific:
#   China mainland: https://dashscope.aliyuncs.com/compatible-mode/v1
#   International:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.8-27b

# Azure only. Leave empty for the model default. Only set for reasoning-model
# deployments (none | low | medium | high); other deployments reject it.
LLM_REASONING_EFFORT=

# Azure OpenAI (v1 API). Endpoint format: https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# JSON list of allowed origins, e.g. ["chrome-extension://<extension-id>"]
CORS_ORIGINS=[]
