# Copy to .env and fill in real values. Never commit .env.

# Shared secret the Chrome extension sends in the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=change-me

DATABASE_URL=sqlite:///./data/jobpilot.db

# Azure OpenAI (v1 API). Endpoint format: https://<resource>.openai.azure.com/openai/v1/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=

# JSON list of allowed origins, e.g. ["chrome-extension://<extension-id>"]
CORS_ORIGINS=[]
